rules_version = '2';

// ⚠️ REGLAS ABIERTAS — NO PROTEGEN LOS DATOS
//
// Mientras los usuarios no estén migrados a Firebase Auth, la app valida la contraseña en
// el propio dispositivo y Firestore no sabe quién hace cada petición (no hay request.auth).
// Por eso estas reglas dejan leer, escribir y BORRAR cualquier documento a cualquiera que
// conozca el proyecto, con o sin la app.
//
// La versión anterior de este archivo decía "permite lectura y escritura pero NO borrado"
// y declaraba colecciones de solo-agregar. No era cierto: las reglas que coinciden con un
// mismo documento se suman (OR), `write` incluye `delete`, y el comodín de abajo coincide
// con todos los documentos. Un `allow delete: if false` no quita lo que otra regla concede.
// El comportamiento es exactamente el mismo que antes; solo se corrige lo que dice.
//
// La protección real está en firestore.secure.rules (probadas en el emulador con
// `npm run test:rules`). Para activarlas: docs/MIGRACION_FIREBASE_AUTH.md
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
