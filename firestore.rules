rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // NOTA: La app usa autenticación custom (Firestore + AsyncStorage), no Firebase Auth.
    // Por eso no se puede usar request.auth. La validación de roles se hace en la app.
    // Las reglas aquí agregan una capa mínima de protección a nivel de operaciones.

    // REGLA POR DEFECTO — permite lectura y escritura pero NO borrado
    match /{document=**} {
      allow read, write: if true;
      allow delete: if false;
    }

    // USUARIOS — no se borran desde el cliente
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // TAREAS — el borrado se hace cambiando status a 'cerrada', no borrando doc
    match /tasks/{taskId} {
      allow read, create, update: if true;
      allow delete: if false;

      match /subtasks/{subtaskId} {
        allow read, create, update: if true;
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }

    // FCM TOKENS — solo crear/leer, no borrar desde cliente
    match /fcmTokens/{tokenId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // REPORTES
    match /reports/{reportId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /task_reports/{reportId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ACTIVIDAD — append-only desde el cliente
    match /task_activity/{activityId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // FIRMAS — inmutables una vez creadas
    match /signatures/{signatureId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // AUDITORÍA — append-only
    match /auditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
