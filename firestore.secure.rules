rules_version = '2';

// Reglas para usar DESPUÉS de migrar los usuarios a Firebase Auth.
// No desplegar antes: sin sesión de Firebase Auth nadie podría leer ni escribir.
// Pasos en docs/MIGRACION_FIREBASE_AUTH.md
//
// IMPORTANTE: las reglas que coinciden con un mismo documento se suman (OR).
// Por eso no hay regla comodín: cada colección se declara de forma explícita y
// cualquier colección no listada queda denegada.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Documento del usuario que hace la petición (users/{uid})
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Usuario con sesión, con documento en users y no desactivado
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().get('active', true) != false;
    }

    function isAdmin() {
      return isActive() && me().role == 'admin';
    }

    // USUARIOS — solo el admin crea, borra o cambia rol/estado/área.
    // Cada usuario puede editar su propio perfil salvo los campos de permisos.
    match /users/{userId} {
      allow read: if isActive();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isActive() && request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['role', 'active', 'email', 'area', 'department', 'direcciones', 'areasPermitidas']));
    }

    // TAREAS — visibilidad por rol (misma regla que utils/taskVisibility.js):
    //   admin      → todas
    //   director   → solo las asignadas a su correo
    //   secretario → las asignadas a su correo y las de su secretaría
    //
    // `secretarias` lo calcula la app al guardar la tarea (áreas + asignados) con
    // nombres canónicos de config/areas.js. Para que un secretario las vea, el campo
    // `area` de su usuario debe ser ese mismo nombre canónico.
    //
    // Las consultas de la app coinciden con estas reglas:
    //   where('assignedTo', 'array-contains', <correo>)
    //   where('secretarias', 'array-contains', <secretaría>)
    function myEmail() {
      return request.auth.token.email;
    }

    function canSeeTask(task) {
      return isAdmin()
        || (isActive() && myEmail() in task.get('assignedTo', []))
        || (isActive() && me().role == 'secretario' && me().area in task.get('secretarias', []));
    }

    // Secretarios y directores solo cambian estado, confirmaciones, delegación y avance.
    // No pueden editar el contenido, mandar a la papelera ni finalizar la tarea.
    function isAllowedTaskUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'updatedBy',
          'completedBy', 'allCompletedAt',
          'assignedTo', 'assignedToNames', 'assignments', 'secretarias',
          'delegatedTo', 'delegatedBy', 'delegatedAt',
          'progress', 'progressPercentage', 'notificationId',
          'subtasksCompleted', 'coordinationProgress', 'allAreasCompletedAt',
          // Chat y reportes de la tarea
          'lastMessageAt', 'lastMessageBy', 'lastMessageByEmail',
          'reports', 'lastReportDate', 'qualityRating', 'ratedAt'
        ])
        && (request.resource.data.get('status', '') != 'cerrada' || resource.data.get('status', '') == 'cerrada');
    }

    match /tasks/{taskId} {
      allow read: if canSeeTask(resource.data);
      allow create: if isAdmin();
      allow update: if isAdmin() || (canSeeTask(resource.data) && isAllowedTaskUpdate());
      // Nadie borra tareas: "eliminar" las manda a la papelera (deleted: true)
      allow delete: if false;

      // Subtareas, mensajes de chat y demás subcolecciones: quien puede ver la tarea
      match /{subcollection}/{docId} {
        allow read, create, update: if canSeeTask(get(/databases/$(database)/documents/tasks/$(taskId)).data);
        allow delete: if isAdmin();
      }
    }

    // REPORTES
    match /task_reports/{reportId} {
      allow read, create, update: if isActive();
      allow delete: if isAdmin();
    }

    // ÁREAS y organigrama — solo el admin modifica
    match /areas/{areaId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }
    match /metadata/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // NOTIFICACIONES y colas de push
    match /notifications/{docId} {
      allow read, write: if isActive();
    }
    match /notification_history/{docId} {
      allow read, write: if isActive();
    }
    match /push_notifications_queue/{docId} {
      allow read, create: if isActive();
    }
    match /scheduled_notifications/{docId} {
      allow read, write: if isActive();
    }
    match /user_push_tokens/{docId} {
      allow read, write: if isActive();
    }
    match /fcmTokens/{docId} {
      allow read, write: if isActive();
    }

    // POMODORO
    match /pomodoroSessions/{docId} {
      allow read, write: if isActive();
    }

    // HISTORIAL, FIRMAS y AUDITORÍA — solo se agregan, nunca se modifican ni borran
    match /task_activity_log/{docId} {
      allow read, create: if isActive();
    }
    match /signatures/{docId} {
      allow read, create: if isActive();
    }
    match /auditLogs/{docId} {
      allow read, create: if isActive();
    }
    match /area_audit/{docId} {
      allow read, create: if isActive();
    }
  }
}
