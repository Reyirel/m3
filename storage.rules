rules_version = '2';

// Reglas de Firebase Storage para la app M3
// Requieren sesión de Firebase Auth (ver docs/MIGRACION_FIREBASE_AUTH.md)
// Probadas en el emulador: npm run test:rules (tests/rules/).
service firebase.storage {
  match /b/{bucket}/o {

    // Solo fotos nuevas, de 5 MB como máximo (la app las reduce antes de subirlas).
    // resource == null: la ruta todavía no existe. Sin esa condición, subir un archivo
    // con el nombre de otro lo reemplazaba.
    function isNewSmallImage() {
      return resource == null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 5 * 1024 * 1024;
    }

    // Imágenes del chat. Se crean y se leen; no se sobrescriben ni se borran, para que
    // nadie pueda alterar o quitar la evidencia que subió otra persona.
    match /chat-images/{imageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isNewSmallImage();
    }

    // Imágenes de reportes de tareas
    match /task_reports/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isNewSmallImage();
    }

    // Regla general - denegar todo lo demás por seguridad
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
